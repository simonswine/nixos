+// or invented count would only mislead the consumers of these stats.
+func (b *snapshotter) qgroupUsage(path string, sync bool) (snapshots.Usage, error) {
+	if sync {
+		// Quota accounting only counts what has reached a transaction. Flush
+		// before reading a value that is about to be persisted.
