+
+// ErrQuotaDisabled is returned when the filesystem carries no quota tree, that
+// is, neither full qgroups (btrfs quota enable) nor simple quotas (btrfs quota
+// enable --simple) are turned on.
+var ErrQuotaDisabled = errors.New("btrfs: quota is not enabled on the filesystem")
+
+// QuotaStatus reports the quota accounting mode of a filesystem, as recorded in
+// the BTRFS_QGROUP_STATUS_KEY item of its quota tree.
+type QuotaStatus struct {
+	// Enabled is true when the filesystem has a quota tree at all.
+	Enabled bool
+
+	// Simple is true when the filesystem uses simple quotas ("squota", Linux
+	// 6.7+), where an extent is charged to the subvolume that created it and
+	// stays charged until it is freed. Accounting is done at write time, so
+	// reading it back is cheap and needs no backref walk.
+	Simple bool
+
+	// Rescanning is true while a qgroup rescan is in flight, during which the
+	// reported numbers are still converging.
+	Rescanning bool
+
+	// Inconsistent is true when the kernel has flagged the accounting as out of
+	// date, which happens when quotas are enabled on a populated filesystem and
+	// no rescan has run since.
+	Inconsistent bool
+
+	Generation uint64
+}
+
+// QgroupInfo is the accounting of a single qgroup, as stored in
+// btrfs_qgroup_info_item.
+//
+// Under both full qgroups and simple quotas, creating a subvolume or a snapshot
+// creates a level 0 qgroup whose id equals the subvolume id, so a subvolume's
+// own accounting can be looked up with SubvolID and QgroupInfoByID.
+type QgroupInfo struct {
+	// ID is the qgroup id. For the level 0 qgroups this package looks up, it is
+	// the subvolume id.
+	ID uint64
+
+	Generation uint64
+
+	// Referenced is the total size of the extents the qgroup references,
+	// including those shared with other qgroups. For a btrfs snapshot this is
+	// roughly the size of the whole rootfs it was cloned from.
+	Referenced           uint64
+	ReferencedCompressed uint64
+
+	// Exclusive is the size of the extents referenced only by this qgroup, that
+	// is, the data that would be freed if the subvolume were deleted. For a
+	// snapshot, this is what has been written since it was taken.
+	Exclusive           uint64
+	ExclusiveCompressed uint64
+}
+
+// Sync forces a transaction commit on the filesystem holding path, flushing
+// delayed allocation so that quota accounting reflects everything written so
+// far. It is the BTRFS_IOC_SYNC ioctl, the same one `btrfs filesystem sync`
+// issues.
+func Sync(path string) error {
+	fp, err := openSubvolDir(path)
+	if err != nil {
+		return err
+	}
+	defer fp.Close()
+
+	return ioctl(fp.Fd(), C.BTRFS_IOC_SYNC, 0)
+}
+
+// Quota returns the quota accounting mode of the filesystem holding path. A
+// filesystem without quotas reports QuotaStatus{Enabled: false} and no error.
+func Quota(path string) (QuotaStatus, error) {
+	fp, err := openSubvolDir(path)
+	if err != nil {
+		return QuotaStatus{}, err
+	}
+	defer fp.Close()
+
+	buf, err := searchQuotaTree(fp.Fd(), C.BTRFS_QGROUP_STATUS_KEY, 0)
+	if err != nil {
+		if errors.Is(err, ErrQuotaDisabled) || errors.Is(err, os.ErrNotExist) {
+			return QuotaStatus{}, nil
+		}
+		return QuotaStatus{}, err
+	}
+
+	// Checked against the gosafe struct, not the kernel one: the kernel grew an
+	// enable_gen field in 6.7 that this package does not read, and a kernel
+	// older than the headers it was built against writes the shorter item.
+	if uintptr(len(buf)) < C.sizeof_struct_gosafe_btrfs_qgroup_status_item {
+		return QuotaStatus{}, fmt.Errorf("btrfs: short qgroup status item (%d bytes)", len(buf))
+	}
+
+	var gsi C.struct_gosafe_btrfs_qgroup_status_item
+	C.unpack_qgroup_status_item(&gsi, (*C.struct_btrfs_qgroup_status_item)(unsafe.Pointer(&buf[0])))
+
+	flags := le64ToNative(gsi.flags)
+
+	return QuotaStatus{
+		Enabled:      flags&C.BTRFS_QGROUP_STATUS_FLAG_ON != 0,
+		Simple:       flags&C.BTRFS_QGROUP_STATUS_FLAG_SIMPLE_MODE != 0,
+		Rescanning:   flags&C.BTRFS_QGROUP_STATUS_FLAG_RESCAN != 0,
+		Inconsistent: flags&C.BTRFS_QGROUP_STATUS_FLAG_INCONSISTENT != 0,
+		Generation:   le64ToNative(gsi.generation),
+	}, nil
+}
+
+// QgroupInfoByID returns the accounting of the level 0 qgroup with the given
+// id, which for the qgroups btrfs creates automatically is the subvolume id.
+//
+// The lookup is a single tree search pinned to one key, so its cost does not
+// grow with the number of subvolumes on the filesystem.
+//
+// ErrQuotaDisabled is returned when the filesystem has no quota tree, and an
+// error wrapping os.ErrNotExist when quotas are on but this subvolume has no
+// qgroup, which is the case for subvolumes created before quotas were enabled.
+func QgroupInfoByID(path string, id uint64) (QgroupInfo, error) {
+	fp, err := openSubvolDir(path)
+	if err != nil {
+		return QgroupInfo{}, err
+	}
+	defer fp.Close()
+
+	buf, err := searchQuotaTree(fp.Fd(), C.BTRFS_QGROUP_INFO_KEY, C.__u64(id))
+	if err != nil {
+		return QgroupInfo{}, err
+	}
+
+	if uintptr(len(buf)) < C.sizeof_struct_gosafe_btrfs_qgroup_info_item {
+		return QgroupInfo{}, fmt.Errorf("btrfs: short qgroup info item for 0/%d (%d bytes)", id, len(buf))
+	}
+
+	var gii C.struct_gosafe_btrfs_qgroup_info_item
+	C.unpack_qgroup_info_item(&gii, (*C.struct_btrfs_qgroup_info_item)(unsafe.Pointer(&buf[0])))
+
+	return QgroupInfo{
+		ID:                   id,
+		Generation:           le64ToNative(gii.generation),
+		Referenced:           le64ToNative(gii.rfer),
+		ReferencedCompressed: le64ToNative(gii.rfer_cmpr),
+		Exclusive:            le64ToNative(gii.excl),
+		ExclusiveCompressed:  le64ToNative(gii.excl_cmpr),
+	}, nil
+}
