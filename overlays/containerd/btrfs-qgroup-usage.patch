+// UsageMode selects how the snapshotter answers Usage for active snapshots.
+type UsageMode string
+
+const (
+	// UsageModeAuto uses btrfs quota accounting when the filesystem has quotas
+	// enabled and falls back to walking the snapshot otherwise. This is the
+	// default.
+	UsageModeAuto UsageMode = "auto"
+
+	// UsageModeQgroup always uses btrfs quota accounting, and fails at plugin
+	// init if the filesystem has no quotas enabled.
+	UsageModeQgroup UsageMode = "qgroup"
+
+	// UsageModeWalk always walks the snapshot recursively. This is accurate but
+	// costs O(layers x rootfs) stat calls per stats collection pass, because
+	// every btrfs snapshot physically contains all of its parents.
+	UsageModeWalk UsageMode = "walk"
+
+	// UsageModeNone reports zero usage for active snapshots without measuring
+	// anything.
+	UsageModeNone UsageMode = "none"
+)
+
+// Opt is an option for NewSnapshotter.
+type Opt func(*snapshotter) error
+
+// WithUsageMode selects how disk usage is computed for active snapshots. An
+// empty mode means UsageModeAuto.
+func WithUsageMode(mode UsageMode) Opt {
+	return func(b *snapshotter) error {
+		switch mode {
+		case "":
+			b.usageMode = UsageModeAuto
+		case UsageModeAuto, UsageModeQgroup, UsageModeWalk, UsageModeNone:
+			b.usageMode = mode
+		default:
+			return fmt.Errorf("unknown btrfs usage mode %q, expected one of %q, %q, %q or %q",
+				mode, UsageModeAuto, UsageModeQgroup, UsageModeWalk, UsageModeNone)
+		}
+		return nil
+	}
+}
