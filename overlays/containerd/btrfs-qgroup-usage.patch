+// searchQuotaTree looks up the single quota tree item (0, keyType, offset) and
+// returns a copy of the item body.
+func searchQuotaTree(fd uintptr, keyType C.__u32, offset C.__u64) ([]byte, error) {
+	var args C.struct_btrfs_ioctl_search_args
+
+	args.key.tree_id = C.BTRFS_QUOTA_TREE_OBJECTID
+	args.key.min_type = keyType
+	args.key.max_type = keyType
+	args.key.min_offset = offset
+	args.key.max_offset = offset
+	args.key.max_transid = ^C.__u64(0)
+	args.key.nr_items = 1
+
+	if err := ioctl(fd, C.BTRFS_IOC_TREE_SEARCH, uintptr(unsafe.Pointer(&args))); err != nil {
+		// The quota tree only exists once quotas have been enabled; asking for
+		// it otherwise is how the kernel tells us they are off.
+		if errors.Is(err, syscall.ENOENT) {
+			return nil, ErrQuotaDisabled
+		}
+		return nil, err
+	}
+
+	if args.key.nr_items == 0 {
+		return nil, fmt.Errorf("btrfs: no quota tree item of type %d at offset %d: %w", keyType, offset, os.ErrNotExist)
+	}
+
+	var (
+		sh     C.struct_btrfs_ioctl_search_header
+		shSize = unsafe.Sizeof(sh)
+		buf    = (*[maxByteSliceSize]byte)(unsafe.Pointer(&args.buf[0]))[:C.BTRFS_SEARCH_ARGS_BUFSIZE]
+	)
+
+	sh = *(*C.struct_btrfs_ioctl_search_header)(unsafe.Pointer(&buf[0]))
+	if sh._type != keyType || sh.offset != offset {
+		return nil, fmt.Errorf("btrfs: quota tree item of type %d at offset %d not found: %w", keyType, offset, os.ErrNotExist)
+	}
+
+	if shSize+uintptr(sh.len) > uintptr(len(buf)) {
+		return nil, fmt.Errorf("btrfs: quota tree item of type %d overruns the search buffer (%d bytes)", keyType, sh.len)
+	}
+
+	// args lives on this frame, so hand back a copy rather than a slice
+	// aliasing it.
+	item := make([]byte, sh.len)
+	copy(item, buf[shSize:shSize+uintptr(sh.len)])
+
+	return item, nil
+}
